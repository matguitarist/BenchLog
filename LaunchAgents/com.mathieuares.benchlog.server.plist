<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "Use This Mac as the Server" (Settings > Sync) registers this with SMAppService.agent.
     It runs the server built into the app at login, and keeps it running. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mathieuares.benchlog.server</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/BenchLogServer</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/BenchLogServer</string>
		<string>--agent</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.mathieuares.benchlog</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
